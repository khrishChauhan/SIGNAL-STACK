# Project Configuration
PROJECT_NAME="Signal Stack"
DEBUG=true

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./data/signal_stack.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/signal_stack"

# AI Provider Configuration
# Set to 'ollama' to use local Ollama model, or 'fallback' for deterministic offline mode
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# Uploads & Storage
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=25

# Crawler
CRAWLER_USER_AGENT="SignalStackBot/1.0 (+https://signalstack.internal; bot@signalstack.internal)"
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MIN_DELAY_SECONDS=1.0
